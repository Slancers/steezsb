# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# ---- Sanity ----
# Project ID from https://www.sanity.io/manage (e.g. abc123de)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only write token with "Editor" or "Write" permissions.
# Used by /api/lead to create lead documents. Never exposed to the client.
SANITY_API_WRITE_TOKEN=

# ---- WhatsApp ----
# E.164 format, NO leading '+' and NO spaces.
# Example: 919876543210 (India country code 91, then 10-digit number)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Analytics ----
# Google Tag Manager container ID, e.g. GTM-XXXXXXX.
# GA4 is configured as a tag inside GTM, not loaded directly.
NEXT_PUBLIC_GTM_ID=

# ---- Site ----
# Full origin, no trailing slash. Used by sitemap, canonical, OG, llms.txt.
NEXT_PUBLIC_SITE_URL=https://steezsb.com

# ---- Error monitoring (optional) ----
# If unset, Sentry init is a no-op and the app runs fine.
SENTRY_DSN=
